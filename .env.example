# --- Database (Neon Postgres in production; any Postgres locally) ---
DATABASE_URL="postgresql://postgres@localhost:5432/edlux"
# Neon: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL
DIRECT_URL="postgresql://postgres@localhost:5432/edlux"

# --- Public site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin authentication (Better Auth) ---
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"
# Used by `npm run db:seed` (required in production, optional in dev)
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD=""

# --- Application secret for hashing verification codes (required in production) ---
APP_SECRET="generate-with: openssl rand -base64 32"

# --- Transactional email ---
# "dev" prints emails to the server console + dev outbox (NEVER works in production)
# "resend" sends real email through Resend
EMAIL_PROVIDER="dev"
RESEND_API_KEY=""
EMAIL_FROM="ED LUX GIFTS <orders@your-verified-domain.example>"

# --- Image storage ---
# Without Cloudinary, uploads are written to public/uploads (local development only)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Expiry job (optional; the app also releases expired reservations lazily) ---
CRON_SECRET=""
